# ==== 环境与密钥 ====
.env
.venv/
__pycache__/
*.pyc
.idea/
.vscode/
.streamlit/
.pytest_cache/

# ==== 前端 ====
node_modules/
frontend/dist/
frontend/.env.local

# ==== 本地数据（运行时生成，不入库） ====
